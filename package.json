{
  "name": "agentic-ai-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Virtual company platform: dynamic divisions of AI agents, tiered model routing via OpenRouter, human-in-the-loop approvals",
  "scripts": {
    "build:packages": "pnpm --filter @platform/db build && pnpm --filter @platform/shared build",
    "build": "pnpm build:packages && pnpm --filter @platform/api build && pnpm --filter @platform/worker build && pnpm --filter @platform/web build",
    "dev:api": "pnpm build:packages && pnpm --filter @platform/api dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @platform/worker dev",
    "dev:web": "pnpm --filter @platform/web dev",
    "db:generate": "pnpm --filter @platform/db prisma generate",
    "db:migrate": "pnpm --filter @platform/db prisma migrate dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "@prisma/client", "@prisma/engines", "esbuild", "prisma"]
  }
}
