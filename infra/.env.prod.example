# Disalin ke infra/.env.prod di VPS (JANGAN commit file .env.prod yang asli ke git).
# Section dan nama variabel sengaja sama persis dengan infra/.env.example -
# yang beda cuma nilainya (hostname docker network, bukan localhost).

# --- Shared: host of apps/api ---
# api/worker/web semuanya baca file .env.prod ini (lihat env_file: di
# docker-compose.prod.yml) - jadi host API cukup diubah di SATU tempat ini,
# tidak ada lagi yang di-hardcode di compose.
API_URL=http://api:4000
PORT=4000

# --- apps/api ---
DATABASE_URL=postgresql://platform:CHANGE_ME@postgres:5432/platform
KAFKA_BROKERS=kafka:9092

OPENROUTER_API_KEY=

OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=platform
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
OBJECT_STORAGE_BUCKET=agent-outputs

# --- apps/worker ---
# Reuses API_URL, DATABASE_URL, KAFKA_BROKERS, OPENROUTER_API_KEY, dan
# OBJECT_STORAGE_* di atas, sama seperti di .env.example.

# --- apps/web ---
# Browser tetap pakai path relatif "/api" (diteruskan Caddy -> web -> api),
# jadi NEXT_PUBLIC_API_URL tidak perlu diisi di production. Override di sini
# hanya kalau web di-serve dari origin lain yang tidak proxy ke api sendiri.
# NEXT_PUBLIC_API_URL=

# --- Release ke Caddy (apps/api/src/releases) ---
# RELEASES_DIR dan CADDY_RELEASE_HELPER_SOCKET harus sama persis dengan path
# host yang di-bind-mount ke container `api` di docker-compose.prod.yml -
# lihat infra/caddy-release-helper/README.md untuk setup helper-nya.
RELEASES_DIR=/opt/ruang-vraxen/releases-data
RELEASE_BASE_DOMAIN=vraxen-group.com
RELEASE_HOST_IP=CHANGE_ME_IP_VPS_PUBLIK
CADDY_RELEASE_HELPER_SOCKET=/opt/ruang-vraxen/caddy-release-helper.sock
CADDY_RELEASE_HELPER_TOKEN=CHANGE_ME_SAMA_DENGAN_CADDY_RELEASE_HELPER_ENV
