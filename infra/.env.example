# Local dev values. Copy this file to apps/api/.env, apps/worker/.env, and
# apps/web/.env — each app loads its own copy (apps/api via @nestjs/config,
# apps/worker via dotenv, apps/web via Next.js's built-in .env support).
# Variable names/sections here mirror infra/.env.prod.example 1:1, so moving
# to the VPS is just swapping values, not variable names.

# --- Shared: host of apps/api ---
# Used by apps/api (which port to listen on) and read by apps/worker +
# apps/web (server-side fetches) to know where to reach it. In production
# this is the api container's internal DNS name (see .env.prod.example);
# locally it's just localhost.
API_URL=http://localhost:4000
PORT=4000

# --- apps/api ---
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
KAFKA_BROKERS=localhost:9092

# OpenRouter - one key, free and paid models both go through it.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# S3-compatible (MinIO locally; swap for a real bucket in production)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=platform
OBJECT_STORAGE_SECRET_KEY=platform123
OBJECT_STORAGE_BUCKET=agent-outputs

# --- apps/worker ---
# Reuses API_URL, DATABASE_URL, KAFKA_BROKERS, OPENROUTER_API_KEY, and
# OBJECT_STORAGE_* above - worker reads Postgres directly for queries, but
# every write goes through apps/api over API_URL.

# --- apps/web ---
# Browser-side calls: same-origin "/api", forwarded to API_URL by Next's
# rewrite (see apps/web/next.config.ts). Only override this if the web app
# is served from a different origin than its own API proxy.
NEXT_PUBLIC_API_URL=/api
